{
  "compilerOptions": {
    "target": "ES2025", // Emit JavaScript using the ES2025 language baseline, matching the project's modern Node.js runtime assumptions.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2025"], // Type-check ES2025 standard library APIs such as Array.prototype.toSorted.
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true
  }
}