{
  "name": "score-audio-studio",
  "version": "1.0.0",
  "description": "Music score domain models, validation, and playback-oriented tooling.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:evidence": "node tools/generate-test-evidence.mjs",
    "build": "tsc --build",
    "typecheck": "tsc --build && tsc --project packages/score-domain/tsconfig.test.json && tsc --project packages/playback-compiler/tsconfig.test.json",
    "test:watch": "vitest",
    "clean": "npm run clean --workspaces --if-present",
    "clean:evidence": "node tools/clean-test-evidence.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
